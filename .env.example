# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""

# Next Auth Discord Provider
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Google sign-in
# Redirect URI to register with the provider: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Facebook sign-in
# Redirect URI to register with the provider: <NEXT_PUBLIC_APP_URL>/api/auth/facebook/callback
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""
# Optional Facebook Login for Business configuration; replaces the email/public_profile scopes.
CONFIGURATION_ID=""

# Instagram sign-in
# Redirect URI to register with the provider: <NEXT_PUBLIC_APP_URL>/api/auth/instagram/callback
AUTH_INSTAGRAM_ID=""
AUTH_INSTAGRAM_SECRET=""

# Public origin OAuth redirect URIs are built from (falls back to the request host).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sara"

# Direct (non-pooled) connection, used only by `prisma migrate`. Required when
# DATABASE_URL points through a connection pooler (e.g. Supabase's PgBouncer on
# port 6543/?pgbouncer=true) — Prisma Migrate needs a direct connection for the
# advisory locks/DDL it relies on. Leave unset for a non-pooled DATABASE_URL.
DIRECT_URL=""

# Atlas Maps Server (self-hosted, see compose.yaml)
# In Docker Compose this is automatically set to http://atlas:3001
ATLAS_API_URL="http://localhost:3001"

# Resend (transactional email: welcome, bookings, invoices, receipts)
# https://resend.com/api-keys
RESEND_API_KEY=""
# Sender for every email, on a domain verified in Resend (defaults to
# "Sara <bookings@sara.app>"). Without RESEND_API_KEY, emails are printed to
# the server log instead of sent.
EMAIL_FROM=""

# Shared secret for the reminder cron endpoint (GET /api/cron/booking-reminders).
# Your scheduler (Vercel Cron, system cron, k8s CronJob, etc.) must send this value
# as `Authorization: Bearer <CRON_SECRET>` when calling the endpoint.
# Generate one with: openssl rand -hex 32
CRON_SECRET=""

# Google Calendar sync reuses the AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET OAuth client above —
# no separate client is needed. In the Google Cloud Console for that OAuth client, add a second
# authorized redirect URI for the Calendar connect flow (distinct from the login callback):
#   http://localhost:3000/api/business/google-calendar/callback
# and enable the Google Calendar API for the project.

# WhatsApp Cloud API + Instagram Messaging (Meta)
WHATSAPP_VERIFY_TOKEN=""        # arbitrary string also set in the Meta webhook config
WHATSAPP_PHONE_NUMBER_ID=""     # from WhatsApp > API Setup
WHATSAPP_TOKEN=""               # permanent system-user access token
NEXT_PUBLIC_SARA_WHATSAPP_NUMBER=""  # public number owners message, digits only (e.g. 2348012345678); landing CTA opens wa.me/<number>
META_APP_SECRET=""              # Meta App > Settings > Basic > App Secret (webhook signature)
INSTAGRAM_VERIFY_TOKEN=""       # arbitrary string for the IG webhook config
INSTAGRAM_IG_ID=""              # Instagram professional account id (sends DMs)
INSTAGRAM_PAGE_TOKEN=""         # page/IG access token for messaging
