generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Enums ---

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
  OVERDUE
}

enum PaymentMethod {
  STRIPE
  PAYSTACK
  CASH
  BANK_TRANSFER
}

enum Provider {
  google
  facebook
  instagram
}

// --- Auth & Core ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  provider      Provider?
  accounts      Account[]
  sessions      Session[]

  // A user account is a business owner
  business Business?

  @@index([email])
  @@index([provider])
}

model Business {
  id          String   @id @default(cuid())
  ownerId     String   @unique
  name        String
  slug        String   @unique
  description String?
  phone       String?
  email       String?
  address     String?
  city        String?
  state       String?
  country     String?
  logoUrl     String?
  latitude    Decimal? @db.Decimal(12, 9)
  longitude   Decimal? @db.Decimal(12, 9)
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Payment Settlement (Mono + Paystack)
  settlementBank         String?  // Bank code (e.g. "044" for Access Bank)
  settlementAccount      String?  // NUBAN account number
  settlementAccountName  String?  // Verified account holder name
  paystackSubaccountCode String?  @unique // Paystack subaccount code (e.g. "ACCT_xxxxx")
  monoAccountId          String?  // Mono linked account ID

  // Google Calendar Sync
  googleCalendarId           String? // Calendar to sync to; defaults to "primary" when connected
  googleCalendarAccessToken  String? // Short-lived; refreshed on demand
  googleCalendarRefreshToken String? // Long-lived; obtained once at connect time
  googleCalendarTokenExpiry  DateTime?
  googleCalendarConnectedAt  DateTime?

  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  services         Service[]
  bookings         Booking[]
  invoices         Invoice[]
  payments         Payment[]
  receipts         Receipt[]
  gallery          GalleryItem[]
  businessHours    BusinessHours[]
  businessClosures BusinessClosure[]
  chatIdentities   ChatIdentity[]

  @@index([ownerId])
  @@index([slug])
}

// --- Scheduling ---

model BusinessHours {
  id         String  @id @default(cuid())
  businessId String
  dayOfWeek  Int // 0 = Sunday .. 6 = Saturday
  startTime  String // "HH:mm", 24hr
  endTime    String // "HH:mm", 24hr
  isClosed   Boolean @default(false)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model BusinessClosure {
  id         String   @id @default(cuid())
  businessId String
  date       DateTime @db.Date
  reason     String?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
  @@index([businessId])
}

// --- Business Entities ---

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  businessId  String
  name        String
  description String?
  image String?
  price       Decimal  @db.Decimal(10, 2)
  duration    Int // Duration in minutes
  availableFrom String @default("08:00") // Start of availability window (24hr, e.g. "08:00")
  availableTo   String @default("17:00") // End of availability window (24hr, e.g. "17:00")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  invoices     InvoiceService[]
  receipts     ReceiptService[]

  @@index([businessId])
  @@index([slug])
}

// --- Transactions ---

model Booking {
  id         String        @id @default(cuid())
  slug       String        @unique
  businessId String
  serviceId  String
  startTime  DateTime
  endTime    DateTime
  status     BookingStatus @default(PENDING)
  notes      String?

  // Client Details (Snapshot)
  clientName  String
  clientEmail String?
  clientPhone String?

  // OSM Routing fields
  clientLat     Decimal? @db.Decimal(12, 9)
  clientLong    Decimal? @db.Decimal(12, 9)
  distanceKm    Decimal? @db.Decimal(10, 2)
  durationMin   Int?
  routePolyline String?  @db.Text // Encoded polyline for mapping

  // Scheduling & Calendar Sync
  reminderSentAt DateTime? // Set once the 24h-ahead reminder email has been sent
  googleEventId  String? // The synced Google Calendar event id, if the business has Calendar connected

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id])
  invoice  Invoice?

  @@index([businessId])
  @@index([serviceId])
  @@index([slug])
}

model Invoice {
  id            String        @id @default(cuid())
  slug          String        @unique
  businessId    String
  bookingId     String?       @unique
  invoiceNumber String // e.g., INV-1001
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("USD")

  // Client Details (Snapshot)
  clientName  String
  clientEmail String?
  clientPhone String?

  // Financial Details
  subtotal   Decimal @db.Decimal(10, 2)
  taxAmount  Decimal @default(0) @db.Decimal(10, 2)
  discount   Decimal @default(0) @db.Decimal(10, 2)
  total      Decimal @db.Decimal(10, 2)
  amountPaid Decimal @default(0) @db.Decimal(10, 2)

  dueAt     DateTime?
  sentAt    DateTime?
  paidAt    DateTime?
  notes     String?
  url       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  services InvoiceService[]
  payments Payment[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([bookingId])
  @@index([slug])
}

model Receipt {
  id            String  @id @default(cuid())
  slug          String  @unique
  businessId    String
  paymentId     String? @unique
  receiptNumber String // e.g., RCP-1001

  // Client Details (Snapshot)
  name  String?
  email String?
  phone String?

  // Financial Details
  currency      String         @default("USD")
  subtotal      Decimal        @default(0) @db.Decimal(10, 2)
  taxAmount     Decimal        @default(0) @db.Decimal(10, 2)
  discount      Decimal        @default(0) @db.Decimal(10, 2)
  total         Decimal        @db.Decimal(10, 2)
  amountPaid    Decimal        @db.Decimal(10, 2)
  paymentMethod PaymentMethod?

  notes String?
  url   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payment  Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  services ReceiptService[]

  @@unique([businessId, receiptNumber])
  @@index([businessId])
  @@index([paymentId])
  @@index([slug])
}

model InvoiceService {
  invoiceId   String
  serviceId   String
  description String?
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([invoiceId, serviceId])
  @@index([invoiceId])
  @@index([serviceId])
}

model ReceiptService {
  receiptId   String
  serviceId   String
  description String?
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([receiptId, serviceId])
  @@index([receiptId])
  @@index([serviceId])
}

model Payment {
  id         String        @id @default(cuid())
  businessId String
  invoiceId  String?
  amount     Decimal       @db.Decimal(10, 2)
  method     PaymentMethod
  reference  String?       @unique // External transaction ID

  // Client Details (Snapshot)
  clientName  String?
  clientEmail String?
  clientPhone String?

  createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  receipt  Receipt?

  @@index([businessId])
  @@index([invoiceId])
}




model GalleryItem {
  id         String   @id @default(cuid())
  businessId String
  url        String
  caption    String?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// --- Auth.js Internals ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ChatChannel {
  WHATSAPP
  INSTAGRAM
}

model ChatIdentity {
  id          String      @id @default(cuid())
  businessId  String
  channel     ChatChannel
  externalId  String // WhatsApp phone (E.164) or Instagram-scoped user ID (IGSID)
  displayName String?
  linkedAt    DateTime    @default(now())

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  session  ChatSession?

  @@unique([channel, externalId])
  @@index([businessId])
}

model ChatSession {
  id                 String   @id @default(cuid())
  identityId         String   @unique
  state              String   @default("MAIN_MENU")
  context            Json?
  lastProcessedMsgId String?
  lastActiveAt       DateTime @default(now())

  identity ChatIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
}

model ChatLinkToken {
  id         String      @id @default(cuid())
  token      String      @unique
  channel    ChatChannel
  externalId String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime    @default(now())

  @@index([token])
}
